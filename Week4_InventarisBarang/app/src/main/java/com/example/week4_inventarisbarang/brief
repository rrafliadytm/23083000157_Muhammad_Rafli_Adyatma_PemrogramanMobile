/**
 * TambahBarangScreen digunakan untuk menambah barang baru ATAU mengedit barang yang sudah ada.
 *
 * Analogi: Seperti formulir pendaftaran produk baru —
 * user mengisi nama, kategori, harga, stok, dll.
 * Jika editBarangId != null, formulir ini terisi data barang yang sudah ada (mode edit).
 *
 * Fitur Upload Gambar:
 * - Menggunakan ActivityResultContracts.GetContent() untuk membuka galeri
 * - URI gambar yang dipilih disimpan sebagai String di SharedPreferences
 * - FLAG_GRANT_READ_URI_PERMISSION memastikan app tetap bisa akses gambar
 *   setelah restart
 *
 * @param navController Controller navigasi
 * @param editBarangId  Jika null → mode tambah baru.
 *                      Jika ada nilai → mode edit (ID barang yang diedit)
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun TambahBarangScreen(
    navController: NavHostController,
    editBarangId: Long? = null
) {
    val context = LocalContext.current
    val repository = remember { BarangRepository(context) }
    val scope = rememberCoroutineScope()
    val snackbarHostState = remember { SnackbarHostState() }

    // Tentukan apakah mode edit atau tambah baru
    val isEditMode = editBarangId != null

    // Jika mode edit, ambil data barang yang sudah ada
    val existingBarang = if (isEditMode) {
        remember { repository.getBarangById(editBarangId!!) }
    } else null

    // === STATE FORM ===
    // Setiap field form memiliki state sendiri
    // Jika mode edit, isi dengan data yang sudah ada
    var nama by remember { mutableStateOf(existingBarang?.nama ?: "") }
    var kategori by remember { mutableStateOf(existingBarang?.kategori ?: "") }
    var harga by remember { mutableStateOf(
        if (existingBarang != null && existingBarang.harga > 0)
            existingBarang.harga.toLong().toString()
        else ""
    ) }
    var stok by remember { mutableStateOf(
        if (existingBarang != null && existingBarang.stok > 0)
            existingBarang.stok.toString()
        else ""
    ) }
    var sku by remember { mutableStateOf(existingBarang?.sku ?: "") }
    var berat by remember { mutableStateOf(
        if (existingBarang != null && existingBarang.berat > 0)
            existingBarang.berat.toString()
        else ""
    ) }
    var deskripsi by remember { mutableStateOf(existingBarang?.deskripsi ?: "") }
    var gambarUri by remember { mutableStateOf(existingBarang?.gambarUri ?: "") }

    // State untuk dropdown kategori
    var expandedKategori by remember { mutableStateOf(false) }

    // Daftar kategori yang tersedia
    val daftarKategori = listOf(
        "Elektronik", "Fashion", "Aksesoris",
        "Alat Tulis", "Makanan", "Minuman",
        "Peralatan Rumah", "Olahraga", "Lainnya"
    )

    // === IMAGE PICKER ===
    /**
     * rememberLauncherForActivityResult membuat launcher untuk memilih gambar dari galeri.
     *
     * Cara kerja:
     * 1. Saat tombol "Pilih Gambar" diklik, launcher.launch("image/*") dipanggil
     * 2. Android membuka galeri/file picker
     * 3. User memilih gambar
     * 4. URI gambar yang dipilih dikembalikan ke callback
     *
     * takePersistableUriPermission() memastikan app tetap punya izin
     * membaca gambar tersebut bahkan setelah app di-restart.
     * Tanpa ini, URI bisa expired dan gambar tidak bisa ditampilkan lagi.
     */
    val imagePickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent()
    ) { uri: Uri? ->
        uri?.let {
            // Minta izin persisten untuk membaca URI ini
            // Ini penting agar gambar tetap bisa diakses setelah app restart
            try {
                context.contentResolver.takePersistableUriPermission(
                    it,
                    android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION
                )
            } catch (e: SecurityException) {
                // Beberapa provider tidak mendukung persistable permission
                // Gambar tetap bisa ditampilkan selama sesi ini
            }
            // Simpan URI sebagai String
            gambarUri = it.toString()
        }
    }

    /**
     * Fungsi untuk menyimpan data barang (tambah baru atau update).
     *
     * Validasi sederhana:
     * - Nama dan kategori wajib diisi
     * - Jika tidak valid, tampilkan Snackbar error
     * - Jika valid, simpan ke SharedPreferences via repository
     */
    fun simpanBarang() {
        // Validasi input wajib
        if (nama.isBlank() || kategori.isBlank()) {
            scope.launch {
                snackbarHostState.showSnackbar(
                    message = "Nama dan Kategori wajib diisi!",
                    duration = SnackbarDuration.Short
                )
            }
            return
        }

        // Buat objek Barang dari data form
        val barangBaru = Barang(
            id = existingBarang?.id ?: System.currentTimeMillis(),
            nama = nama.trim(),
            kategori = kategori,
            harga = harga.toDoubleOrNull() ?: 0.0,
            stok = stok.toIntOrNull() ?: 0,
            sku = sku.trim(),
            berat = berat.toDoubleOrNull() ?: 0.0,
            deskripsi = deskripsi.trim(),
            gambarUri = gambarUri
        )

        // Simpan ke SharedPreferences
        if (isEditMode) {
            repository.updateBarang(barangBaru)
        } else {
            repository.tambahBarang(barangBaru)
        }

        // Tampilkan Snackbar sukses
        scope.launch {
            snackbarHostState.showSnackbar(
                message = if (isEditMode) "Barang berhasil diperbarui"
                          else "Barang berhasil ditambahkan",
                duration = SnackbarDuration.Short
            )
        }

        // Kembali ke screen sebelumnya
        navController.popBackStack()
    }

    Scaffold(
        // === TOP APP BAR ===
        topBar = {
            TopAppBar(
                title = {
                    Text(if (isEditMode) "Edit Barang" else "Tambah Barang")
                },
                navigationIcon = {
                    IconButton(onClick = { navController.popBackStack() }) {
                        Icon(
                            Icons.AutoMirrored.Filled.ArrowBack,
                            contentDescription = "Kembali"
                        )
                    }
                },
                actions = {
                    // Tombol centang (✓) untuk menyimpan — alternatif tombol Simpan
                    IconButton(onClick = { simpanBarang() }) {
                        Icon(
                            Icons.Default.Check,
                            contentDescription = "Simpan"
                        )
                    }
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = MaterialTheme.colorScheme.primaryContainer,
                    titleContentColor = MaterialTheme.colorScheme.onPrimaryContainer
                )
            )
        },
        snackbarHost = { SnackbarHost(snackbarHostState) }
    ) { paddingValues ->

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
                .verticalScroll(rememberScrollState())
                .padding(16.dp)
        ) {
            // === UPLOAD GAMBAR ===
            Card(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(if (gambarUri.isNotEmpty()) 180.dp else 120.dp)
                    .clickable {
                        // Buka galeri untuk memilih gambar
                        // "image/*" berarti semua tipe file gambar (jpg, png, dll)
                        imagePickerLauncher.launch("image/*")
                    },
                shape = RoundedCornerShape(12.dp),
                colors = CardDefaults.cardColors(
                    containerColor = MaterialTheme.colorScheme.surfaceVariant
                )
            ) {
                if (gambarUri.isNotEmpty()) {
                    // Tampilkan gambar yang sudah dipilih
                    Box {
                        AsyncImage(
                            model = ImageRequest.Builder(LocalContext.current)
                                .data(Uri.parse(gambarUri))
                                .crossfade(true)
                                .build(),
                            contentDescription = "Gambar barang",
                            modifier = Modifier
                                .fillMaxSize()
                                .clip(RoundedCornerShape(12.dp)),
                            contentScale = ContentScale.Crop
                        )
                        // Badge "Tap untuk ganti" di atas gambar
                        Surface(
                            modifier = Modifier
                                .align(Alignment.BottomCenter)
                                .padding(8.dp),
                            shape = RoundedCornerShape(16.dp),
                            color = MaterialTheme.colorScheme.surface.copy(alpha = 0.85f)
                        ) {
